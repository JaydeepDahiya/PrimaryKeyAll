{
  "info": {
    "_postman_id": "b62dc5c4-5c45-4df5-b8cb-91d715d930e9",
    "name": "PrimaryKeyAll REST API tests",
    "description": "CRUD smoke tests for all Spring Data REST repositories. Run against a disposable test database; the collection creates and deletes one record per endpoint.\n\nAuthor: Jaydeep Dahiya",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "lifecycleExpectedField",
      "value": ""
    },
    {
      "key": "lifecycleExpectedValue",
      "value": ""
    },
    {
      "key": "lifecyclePatchField",
      "value": ""
    },
    {
      "key": "lifecyclePatchValue",
      "value": "Updated by Postman"
    },
    {
      "key": "lifecycleItemUrl",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.unset('lifecycleItemUrl');",
          "pm.test('POST creates a resource', function () {",
          "    pm.response.to.have.status(201);",
          "    const created = pm.response.json();",
          "    const self = created && created._links && created._links.self;",
          "    pm.expect(self && self.href, 'HAL self link').to.be.a('string');",
          "    pm.expect(created[pm.collectionVariables.get('lifecycleExpectedField')]).to.eql(pm.collectionVariables.get('lifecycleExpectedValue'));",
          "});",
          "",
          "const created = pm.response.json();",
          "const self = created && created._links && created._links.self;",
          "const itemUrl = self && self.href;",
          "if (itemUrl) {",
          "    pm.collectionVariables.set('lifecycleItemUrl', itemUrl);",
          "    const expectedField = pm.collectionVariables.get('lifecycleExpectedField');",
          "    const expectedValue = pm.collectionVariables.get('lifecycleExpectedValue');",
          "    const patchField = pm.collectionVariables.get('lifecyclePatchField');",
          "    const patchValue = pm.collectionVariables.get('lifecyclePatchValue');",
          "    const headers = { Accept: 'application/hal+json' };",
          "",
          "    pm.sendRequest({ url: itemUrl, method: 'GET', header: headers }, function (getError, getResponse) {",
          "        pm.test('GET retrieves the created resource', function () {",
          "            pm.expect(getError).to.eql(null);",
          "            if (!getError) {",
          "                pm.expect(getResponse.code).to.eql(200);",
          "                pm.expect(getResponse.json()[expectedField]).to.eql(expectedValue);",
          "            }",
          "        });",
          "        if (getError || !getResponse || getResponse.code !== 200) return;",
          "",
          "        pm.sendRequest({",
          "            url: itemUrl,",
          "            method: 'PATCH',",
          "            header: { Accept: 'application/hal+json', 'Content-Type': 'application/merge-patch+json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ [patchField]: patchValue }) }",
          "        }, function (patchError, patchResponse) {",
          "            pm.test('PATCH updates the resource', function () {",
          "                pm.expect(patchError).to.eql(null);",
          "                if (!patchError) pm.expect(patchResponse.code).to.eql(200);",
          "            });",
          "            if (patchError || !patchResponse || patchResponse.code !== 200) return;",
          "",
          "            pm.sendRequest({ url: itemUrl, method: 'GET', header: headers }, function (updatedError, updatedResponse) {",
          "                pm.test('GET returns the updated resource', function () {",
          "                    pm.expect(updatedError).to.eql(null);",
          "                    if (!updatedError) {",
          "                        pm.expect(updatedResponse.code).to.eql(200);",
          "                        pm.expect(updatedResponse.json()[patchField]).to.eql(patchValue);",
          "                    }",
          "                });",
          "                if (updatedError || !updatedResponse || updatedResponse.code !== 200) return;",
          "",
          "                pm.sendRequest({ url: itemUrl, method: 'DELETE', header: headers }, function (deleteError, deleteResponse) {",
          "                    pm.test('DELETE removes the resource', function () {",
          "                        pm.expect(deleteError).to.eql(null);",
          "                        if (!deleteError) pm.expect([200, 204]).to.include(deleteResponse.code);",
          "                    });",
          "                });",
          "            });",
          "        });",
          "    });",
          "}"
        ]
      }
    }
  ],
